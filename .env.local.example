# Supabase — get from https://supabase.com/dashboard → project → settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Google Places API — enable Places API (New) in Google Cloud console
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Enrichment provider (stub until you plug in a licensed B2B data provider)
# ENRICHMENT_PROVIDER_API_KEY=
# ENRICHMENT_PROVIDER_BASE_URL=

# LinkedIn API (stub — official OAuth app required)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=

# Instagram Graph API (stub — Meta Business account required)
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_ACCESS_TOKEN=

# Internal cron secret for Vercel cron jobs
CRON_SECRET=a_long_random_secret_here
